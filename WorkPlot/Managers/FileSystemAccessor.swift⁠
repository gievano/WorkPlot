import Foundation

public enum IntegrityStatus {
    case valid
    case invalidStructure
    case missingFile
}

public final class FileSystemAccessor {
    public static let shared = FileSystemAccessor()
    
    private init() {}
    
    public func readPlist(from path: String) throws -> [String: Any] {
        guard ExploitManager.shared.validateAccess(for: path) else {
            throw ExploitError.sandboxAccessDenied(path)
        }
        
        let url = URL(fileURLWithPath: path)
        guard FileManager.default.fileExists(atPath: path),
              let data = try? Data(contentsOf: url),
              let plist = try? PropertyListSerialization.propertyList(from: data, options: [], format: nil) as? [String: Any] else {
            throw ExploitError.sandboxAccessDenied("Failed to read plist at \(path)")
        }
        return plist
    }
    
    public func writePlist(_ dictionary: [String: Any], to path: String) throws {
        guard ExploitManager.shared.validateAccess(for: path) else {
            throw ExploitError.sandboxAccessDenied(path)
        }
        
        let url = URL(fileURLWithPath: path)
        guard let data = try? PropertyListSerialization.data(fromPropertyList: dictionary, format: .xml, options: 0) else {
            throw ExploitError.sandboxAccessDenied("Failed to serialize plist for \(path)")
        }
        
        do {
            try data.write(to: url, options: .atomic)
            ExploitManager.shared.appendLog("Successfully wrote plist atomically to \(path)")
        } catch {
            throw ExploitError.sandboxAccessDenied("Atomic write failed: \(error.localizedDescription)")
        }
    }
    
    public func backupPlist(at path: String) -> String {
        let timestamp = Int(Date().timeIntervalSince1970)
        let backupPath = "\(path).backup.\(timestamp)"
        let fileManager = FileManager.default
        if fileManager.fileExists(atPath: path) {
            try? fileManager.copyItem(atPath: path, toPath: backupPath)
            ExploitManager.shared.appendLog("Backup created at: \(backupPath)")
        }
        return backupPath
    }
    
    public func verifyIntegrity(of path: String) -> IntegrityStatus {
        do {
            let dict = try readPlist(from: path)
            return dict.isEmpty ? .invalidStructure : .valid
        } catch {
            return .missingFile
        }
    }
}

