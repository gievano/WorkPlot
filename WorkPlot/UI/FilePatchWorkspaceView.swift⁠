import SwiftUI

struct FilePatchWorkspaceView: View {
    @State private var selectedWidth = 1206
    @State private var selectedHeight = 2622
    @State private var alertMsg = ""
    @State private var showAlert = false
    
    let resolutionProfiles = [
        (name: "iPhone 16 Pro (1206 x 2622)", w: 1206, h: 2622),
        (name: "iPhone 16 Pro Max (1290 x 2796)", w: 1290, h: 2796),
        (name: "iPhone 17 Pro Max (1290 x 2868)", w: 1290, h: 2868)
    ]
    
    var body: some View {
        NavigationView {
            Form {
                Section(header: Text("Canvas Resolution & RDAR Fix")) {
                    Picker("Select Device Profile", selection: $selectedWidth) {
                        ForEach(resolutionProfiles, id: \.w) { profile in
                            Text(profile.name).tag(profile.w)
                        }
                    }
                    .onChange(of: selectedWidth) { newW in
                        if let match = resolutionProfiles.first(where: { $0.w == newW }) {
                            selectedHeight = match.h
                        }
                    }
                    
                    Button("Correct Geometry & Apply RDAR Fix") {
                        let result = RDARFix.shared.applyGeometryCorrection(width: selectedWidth, height: selectedHeight)
                        switch result {
                        case .success:
                            _ = SpringBoardManager.safeRespring()
                            alertMsg = "RDAR status bar fix and canvas resolution successfully applied!"
                        case .failure(let error):
                            alertMsg = "Failed to apply RDAR fix: \(error.localizedDescription)"
                        }
                        showAlert = true
                    }
                    .buttonStyle(.borderedProminent)
                }
            }
            .navigationTitle("RDAR & Resolution")
            .alert(isPresented: $showAlert) {
                Alert(title: Text("RDAR Fix Status"), message: Text(alertMsg), dismissButton: .default(Text("OK")))
            }
        }
    }
}

