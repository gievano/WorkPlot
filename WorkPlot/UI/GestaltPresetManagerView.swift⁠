import SwiftUI

struct GestaltPresetManagerView: View {
    let presets = PresetRegistry.shared.fetchPresets()
    @State private var alertMsg = ""
    @State private var showAlert = false
    
    var body: some View {
        NavigationView {
            List(presets) { preset in
                VStack(alignment: .leading, spacing: 6) {
                    Text(preset.name)
                        .font(.headline)
                    Text("Key: \(preset.key) | Category: \(preset.category.rawValue)")
                        .font(.subheadline)
                        .foregroundColor(.secondary)
                    
                    Button("Apply Preset (Staged-Apply)") {
                        let config = [preset.key: preset.value]
                        let targetPath = "/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist"
                        let result = StagedApplyEngine.shared.executeStagedApply(dictionary: config, targetPath: targetPath)
                        
                        switch result {
                        case .success(let backup):
                            alertMsg = "Preset applied successfully! Backup stored at: \(backup)"
                        case .failure(let reason):
                            alertMsg = "Failed to apply preset: \(reason)"
                        }
                        showAlert = true
                    }
                    .buttonStyle(.bordered)
                    .font(.caption)
                }
                .padding(.vertical, 4)
            }
            .navigationTitle("MobileGestalt Registry")
            .alert(isPresented: $showAlert) {
                Alert(title: Text("Preset Application"), message: Text(alertMsg), dismissButton: .default(Text("OK")))
            }
        }
    }
}

