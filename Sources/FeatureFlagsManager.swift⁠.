import Foundation

/// Modul khusus penonaktifan efek Liquid Glass pada iOS 27 Developer Beta 1 - 4
public struct FeatureFlagsManager {
    private static let gestaltCachePath = "/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist"
    
    public static func toggleLiquidGlass(disable: Bool, logger: @escaping (String) -> Void) -> Bool {
        logger("[*] FeatureFlags: Mengakses cache MobileGestalt iOS 27...")
        
        guard let data = FileManager.default.contents(atPath: gestaltCachePath),
              var plist = try? PropertyListSerialization.propertyList(from: data, options: [], format: nil) as? [String: Any] else {
            logger("[-] FeatureFlags: Gagal membaca cache (Sandbox terkunci).")
            return false
        }
        
        var featureFlags = plist["FeatureFlags"] as? [String: Any] ?? [:]
        
        // Memodifikasi parameter rendering Liquid Glass khusus iOS 27 Beta
        featureFlags["LiquidGlassSlider"] = disable ? 0 : 1
        featureFlags["LiquidGlassBlurOptimization"] = disable ? 0 : 1
        plist["FeatureFlags"] = featureFlags
        
        guard let serialized = try? PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0),
              FileManager.default.createFile(atPath: gestaltCachePath, contents: serialized, attributes: nil) else {
            logger("[-] FeatureFlags: Penulisan parameter ditolak oleh sistem.")
            return false
        }
        
        logger(disable ? "[+] FeatureFlags: Efek Liquid Glass dinonaktifkan." : "[+] FeatureFlags: Efek Liquid Glass diaktifkan.")
        return true
    }
}

