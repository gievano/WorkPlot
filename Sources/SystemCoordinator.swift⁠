import Foundation
import SwiftUI

public class SystemCoordinator: ObservableObject {
    public static let shared = SystemCoordinator()
    
    @Published public var targetVersion: String = "iOS 27.0 DB4"
    @Published public var isCompatible: Bool = true
    @Published public var sandboxEscaped: Bool = false
    @Published public var isExecuting: Bool = false
    @Published public var consoleOutput: String = ">>> work.plot diinisialisasi untuk iOS 27 Beta.\n"
    
    private init() {
        let supported = ["iOS 27.0 DB1", "iOS 27.0 DB2", "iOS 27.0 DB3", "iOS 27.0 DB4"]
        isCompatible = supported.contains(targetVersion)
    }
    
    public func log(_ message: String) {
        let formatter = DateFormatter()
        formatter.dateFormat = "HH:mm:ss"
        let timestamp = formatter.string(from: Date())
        DispatchQueue.main.async {
            self.consoleOutput += "[\(timestamp)] \(message)\n"
        }
    }
    
    public func executeBadQuery() {
        isExecuting = true
        log("[*] Menjalankan bad_query sandbox escape...")
        DispatchQueue.global(qos: .userInitiated).async {
            let result = ExploitEngine.executeBadQueryEscape { msg in self.log(msg) }
            DispatchQueue.main.async {
                self.isExecuting = false
                self.sandboxEscaped = result
                if result { UINotificationFeedbackGenerator().notificationOccurred(.success) }
            }
        }
    }
    
    public func toggleLiquidGlass(disable: Bool) {
        log("[*] Memproses pengaturan Liquid Glass...")
        DispatchQueue.global(qos: .userInitiated).async {
            _ = FeatureFlagsManager.toggleLiquidGlass(disable: disable) { msg in self.log(msg) }
        }
    }
    
    public func executeRestart() {
        log("[*] Memulai proses Userspace Restart...")
        DispatchQueue.global(qos: .userInitiated).async {
            ExploitEngine.executeSystemRestart { msg in self.log(msg) }
        }
    }
}

